[run]
source = src
omit =
    */__init__.py
    src/main.py
    tests/*
    venv/*
    .venv/*
    env/*
    .env/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:
    logger.debug
    logger.info
    logger.warning
    logger.error